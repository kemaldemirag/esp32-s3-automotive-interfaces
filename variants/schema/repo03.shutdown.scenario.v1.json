{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rep-03:schema:shutdown-scenario:v1",
  "title": "REP-03 synthetic ignition-shutdown scenario v1",
  "description": "Closed Variant B event contract. It does not perform or prove a real OS shutdown or physical power cut.",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "engine_id",
    "module_id",
    "variant_id",
    "enabled_modules",
    "variant_contract",
    "source",
    "synthetic_data",
    "known_gaps",
    "host_contract",
    "timing_policy",
    "initial_state",
    "events",
    "assertions"
  ],
  "properties": {
    "schema_version": {"const": "repo03.shutdown.scenario.v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "engine_id": {"const": "repo03-shutdown-engine"},
    "module_id": {"const": "shutdown"},
    "variant_id": {"const": "B"},
    "enabled_modules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["automotive_power", "shutdown"]},
      "allOf": [
        {"contains": {"const": "automotive_power"}},
        {"contains": {"const": "shutdown"}}
      ]
    },
    "variant_contract": {"$ref": "#/$defs/variant_contract"},
    "source": {"$ref": "#/$defs/source"},
    "synthetic_data": {"const": true},
    "known_gaps": {
      "type": "array",
      "prefixItems": [{"const": "GAP-04"}],
      "minItems": 1,
      "maxItems": 1
    },
    "host_contract": {"$ref": "#/$defs/host_contract"},
    "timing_policy": {"$ref": "#/$defs/timing_policy"},
    "initial_state": {"const": "IGNITION_ON"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "assertions": {"$ref": "#/$defs/input_assertions"}
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "BLOCKED"]},
    "state": {
      "enum": [
        "IGNITION_ON",
        "NOTIFY_PENDING",
        "WAIT_ACK",
        "GRACE_PERIOD",
        "READY_TO_CUT",
        "POWER_CUT",
        "RESTART"
      ]
    },
    "event_name": {
      "enum": ["ignition-off", "host-notify", "ACK", "timeout", "cut", "restart"]
    },
    "source": {
      "type": "object",
      "required": ["classification", "authority", "reference", "version"],
      "properties": {
        "classification": {
          "enum": [
            "SOURCE_EXPLICIT",
            "DERIVED",
            "ENGINEERING_RULE",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "authority": {
          "enum": ["PROJECT_REQUIREMENT", "HOST_PROTOCOL", "ENGINEERING"]
        },
        "reference": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "nullable_source": {
      "oneOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]
    },
    "variant_contract": {
      "type": "object",
      "required": ["schema_version", "profile_hash", "source"],
      "properties": {
        "schema_version": {"const": "repo03.variant.schema.v1"},
        "profile_hash": {
          "const": "1b82f114d7fb4280f55d3f72a7a61816f38242b7495a23cfa468f17b92d00fcd"
        },
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "host_contract": {
      "type": "object",
      "required": ["raspberry_pi_model", "protocol_id", "source"],
      "properties": {
        "raspberry_pi_model": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "protocol_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "source": {"$ref": "#/$defs/nullable_source"}
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": ["value_ms", "source"],
      "properties": {
        "value_ms": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "source": {"$ref": "#/$defs/nullable_source"}
      },
      "additionalProperties": false
    },
    "timing_policy": {
      "type": "object",
      "required": [
        "ack_timeout_ms",
        "grace_period_ms",
        "ignition_debounce_ms",
        "restart_minimum_ms"
      ],
      "properties": {
        "ack_timeout_ms": {"$ref": "#/$defs/threshold"},
        "grace_period_ms": {"$ref": "#/$defs/threshold"},
        "ignition_debounce_ms": {"$ref": "#/$defs/threshold"},
        "restart_minimum_ms": {"$ref": "#/$defs/threshold"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event", "elapsed_time"],
      "properties": {
        "event": {"$ref": "#/$defs/event_name"},
        "elapsed_time": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "input_assertions": {
      "type": "object",
      "required": ["validation_level", "real_os_shutdown", "physical_power_cut"],
      "properties": {
        "validation_level": {"const": "SYNTHETIC"},
        "real_os_shutdown": {"const": false},
        "physical_power_cut": {"const": false}
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["status", "rule_id", "reason_code", "path", "message"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "rule_id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "threshold_trace": {
      "type": "object",
      "required": ["name", "value_ms", "source", "status"],
      "properties": {
        "name": {
          "oneOf": [
            {"enum": ["ack_timeout_ms", "grace_period_ms", "ignition_debounce_ms", "restart_minimum_ms"]},
            {"type": "null"}
          ]
        },
        "value_ms": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "source": {"$ref": "#/$defs/nullable_source"},
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "BLOCKED", "NOT_APPLICABLE"]}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "sequence",
        "previous_state",
        "event",
        "next_state",
        "elapsed_time",
        "threshold_source",
        "status",
        "rule_id",
        "reason_code"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "previous_state": {"$ref": "#/$defs/state"},
        "event": {"$ref": "#/$defs/event_name"},
        "next_state": {"$ref": "#/$defs/state"},
        "elapsed_time": {"type": "number", "minimum": 0},
        "threshold_source": {"$ref": "#/$defs/threshold_trace"},
        "status": {"$ref": "#/$defs/status"},
        "rule_id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gap_dependency": {
      "type": "object",
      "required": [
        "knowledge_status",
        "blocking_status",
        "rule_id",
        "reason_code",
        "description"
      ],
      "properties": {
        "knowledge_status": {"const": "UNKNOWN"},
        "blocking_status": {"const": "BLOCKED"},
        "rule_id": {"const": "REP03-SHUTDOWN-GAP-004"},
        "reason_code": {"const": "HOST_MODEL_AND_SHUTDOWN_PROTOCOL_UNRESOLVED"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "host_dependency": {
      "type": "object",
      "required": [
        "status",
        "rule_id",
        "reason_code",
        "raspberry_pi_model",
        "protocol_id",
        "source"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "rule_id": {"const": "REP03-SHUTDOWN-HOST-010"},
        "reason_code": {
          "enum": ["HOST_PROTOCOL_PINNED", "HOST_MODEL_OR_PROTOCOL_UNRESOLVED"]
        },
        "raspberry_pi_model": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "protocol_id": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "source": {"$ref": "#/$defs/nullable_source"}
      },
      "additionalProperties": false
    },
    "timing_dependency": {
      "type": "object",
      "required": ["status", "rule_id", "reason_code"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "rule_id": {"const": "REP03-SHUTDOWN-TIME-010"},
        "reason_code": {
          "enum": ["TIMING_POLICY_PINNED", "TIMING_POLICY_UNRESOLVED"]
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": ["GAP-04", "host_protocol", "timing_policy"],
      "properties": {
        "GAP-04": {"$ref": "#/$defs/gap_dependency"},
        "host_protocol": {"$ref": "#/$defs/host_dependency"},
        "timing_policy": {"$ref": "#/$defs/timing_dependency"}
      },
      "additionalProperties": false
    },
    "report_claims": {
      "type": "object",
      "required": [
        "validation_level",
        "real_os_shutdown",
        "physical_power_cut",
        "host_protocol_validated",
        "raspberry_pi_model_validated",
        "safe_shutdown_claim"
      ],
      "properties": {
        "validation_level": {"const": "SYNTHETIC"},
        "real_os_shutdown": {"const": false},
        "physical_power_cut": {"const": false},
        "host_protocol_validated": {"const": false},
        "raspberry_pi_model_validated": {"const": false},
        "safe_shutdown_claim": {"const": false}
      },
      "additionalProperties": false
    },
    "run_report": {
      "type": "object",
      "required": [
        "schema_version",
        "scenario_id",
        "engine_id",
        "module_id",
        "variant_id",
        "status",
        "result",
        "rule_id",
        "reason_code",
        "input_hash",
        "tool_version",
        "synthetic_data",
        "initial_state",
        "final_state",
        "time_unit",
        "trace",
        "dependencies",
        "issues",
        "claims"
      ],
      "properties": {
        "schema_version": {"const": "repo03.shutdown.scenario.v1"},
        "scenario_id": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "engine_id": {"const": "repo03-shutdown-engine"},
        "module_id": {"const": "shutdown"},
        "variant_id": {
          "oneOf": [{"type": "string"}, {"type": "null"}]
        },
        "status": {"$ref": "#/$defs/status"},
        "result": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"$ref": "#/$defs/status"}},
          "additionalProperties": false
        },
        "rule_id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_version": {"const": "repo03-shutdown-engine/1.0.0"},
        "synthetic_data": {"const": true},
        "initial_state": {"const": "IGNITION_ON"},
        "final_state": {"$ref": "#/$defs/state"},
        "time_unit": {"const": "ms"},
        "trace": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "claims": {"$ref": "#/$defs/report_claims"}
      },
      "additionalProperties": false
    }
  }
}
